<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background">

    <TextView
        android:id="@+id/top_brand_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="VORNEX"
        android:textColor="@color/launcher_green_bright"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/account_spinner" />

    <TextView
        android:id="@+id/top_brand_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:text="MINECRAFT  •  JAVA LAUNCHER"
        android:textColor="@color/launcher_muted"
        android:textSize="8sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        app:layout_constraintStart_toEndOf="@id/top_brand_title"
        app:layout_constraintBottom_toBottomOf="@id/top_brand_title" />

    <ImageButton
        android:id="@+id/youtube_channel_button"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/launcher_nav_item"
        android:contentDescription="Vornex Launcher YouTube channel"
        android:src="@drawable/ic_youtube"
        android:scaleType="fitCenter"
        android:padding="6dp"
        app:layout_constraintStart_toEndOf="@id/top_brand_subtitle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/account_spinner" />

    <com.kdt.mcgui.AccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="6dp"
        android:dropDownWidth="@dimen/_218sdp"
        android:dropDownVerticalOffset="34dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintStart_toEndOf="@id/youtube_channel_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/setting_button"
        tools:ignore="RtlSymmetry" />

    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="34dp"
        android:layout_height="30dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/launcher_nav_item"
        android:contentDescription="Settings"
        android:src="@drawable/ic_px_sliders"
        android:tint="@color/launcher_green_bright"
        android:scaleType="fitCenter"
        android:padding="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/topbar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/launcher_panel_border"
        app:layout_constraintTop_toBottomOf="@id/account_spinner" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:name="git.artdeell.mojo.fragments.MainMenuFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout"
        app:layout_constraintTop_toBottomOf="@id/topbar_divider" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
