<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:id="@+id/play_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/vornex_bottom_nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Vornex VL logo"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Vornex Launcher"
                android:textColor="@color/primary_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Minecraft Java Launcher"
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />

            <com.kdt.mcgui.AccountSpinner
                android:id="@+id/account_spinner"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:dropDownWidth="@dimen/_250sdp"
                android:dropDownVerticalOffset="@dimen/_52sdp"
                android:paddingEnd="@dimen/_52sdp"
                android:background="@drawable/account_header_background" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/launcher_play_button"
                android:text="@string/main_play"
                android:textAllCaps="false"
                android:textColor="@color/launcher_text"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/vornex_card"
                android:paddingStart="12dp"
                android:paddingEnd="6dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:drawableEnd="@drawable/spinner_arrow"
                    app:drawableEndSize="@dimen/padding_heavy"
                    app:drawableStartIntegerScaling="true"
                    app:drawableStartSize="34dp"
                    app:drawableEndPadding="1dp" />

                <ImageButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/launcher_nav_item"
                    android:contentDescription="Edit selected version"
                    android:src="@drawable/ic_px_edit"
                    android:padding="10dp" />

                <ImageButton
                    android:id="@+id/add_version_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/launcher_nav_item"
                    android:contentDescription="Add Minecraft version"
                    android:src="@drawable/ic_add"
                    android:padding="10dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="10dp"
                android:text="ADD-ONS &amp; CUSTOMIZATION"
                android:textColor="@color/primary_text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="start" />

            <LinearLayout
                android:id="@+id/nav_mods_card"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/vornex_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_vornex_mods" android:contentDescription="Mods"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="22dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mods" android:textColor="@color/primary_text" android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Discover Minecraft mods" android:textColor="@color/secondary_text" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/launcher_blue" android:textSize="32sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_resourcepacks"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/vornex_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_vornex_resourcepacks" android:contentDescription="Resource packs"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resource Packs" android:textColor="@color/primary_text" android:textSize="17sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Change the look of your game" android:textColor="@color/secondary_text" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/launcher_blue" android:textSize="32sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_shaders"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/vornex_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_vornex_shaders" android:contentDescription="Shaders"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shaders" android:textColor="@color/primary_text" android:textSize="17sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enhance your visuals" android:textColor="@color/secondary_text" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/launcher_blue" android:textSize="32sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_modpacks"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/vornex_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_vornex_modpacks" android:contentDescription="Modpacks"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modpacks" android:textColor="@color/primary_text" android:textSize="17sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Explore curated modpacks" android:textColor="@color/secondary_text" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/launcher_blue" android:textSize="32sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_skins_capes"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/vornex_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_px_edit" android:contentDescription="Skins and capes"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Skins &amp; Capes" android:textColor="@color/primary_text" android:textSize="17sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Customize your character" android:textColor="@color/secondary_text" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/launcher_blue" android:textSize="32sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/home_dynamic_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/vornex_bottom_nav" />

    <LinearLayout
        android:id="@+id/vornex_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/vornex_nav_bar"
        android:paddingHorizontal="6dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView android:id="@+id/nav_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:drawableTop="@drawable/ic_vornex_home" android:drawablePadding="4dp" android:text="Home" android:textColor="@color/launcher_text" android:textSize="10sp" android:background="@drawable/launcher_nav_item" android:clickable="true" android:focusable="true" android:paddingTop="7dp" android:paddingBottom="4dp"/>
        <TextView android:id="@+id/nav_mods" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:drawableTop="@drawable/ic_vornex_folder" android:drawablePadding="4dp" android:text="Folder" android:textColor="@color/launcher_text" android:textSize="10sp" android:background="@drawable/launcher_nav_item" android:clickable="true" android:focusable="true" android:paddingTop="7dp" android:paddingBottom="4dp"/>
        <TextView android:id="@+id/nav_controls" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:drawableTop="@drawable/ic_vornex_controls" android:drawablePadding="4dp" android:text="Controls" android:textColor="@color/launcher_text" android:textSize="10sp" android:background="@drawable/launcher_nav_item" android:clickable="true" android:focusable="true" android:paddingTop="7dp" android:paddingBottom="4dp"/>
        <TextView android:id="@+id/nav_more" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:drawableTop="@drawable/ic_vornex_more" android:drawablePadding="4dp" android:text="More" android:textColor="@color/launcher_text" android:textSize="10sp" android:background="@drawable/launcher_nav_item" android:clickable="true" android:focusable="true" android:paddingTop="7dp" android:paddingBottom="4dp"/>
        <TextView android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:drawableTop="@drawable/ic_vornex_settings" android:drawablePadding="4dp" android:text="Settings" android:textColor="@color/launcher_text" android:textSize="10sp" android:background="@drawable/launcher_nav_item" android:clickable="true" android:focusable="true" android:paddingTop="7dp" android:paddingBottom="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>