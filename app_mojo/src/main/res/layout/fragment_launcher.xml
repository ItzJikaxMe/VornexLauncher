<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:id="@+id/play_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/vornex_bottom_nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="22dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Vornex logo"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="11dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VORNEX"
                        android:textColor="@color/primary_text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="MINECRAFT JAVA LAUNCHER"
                        android:textColor="@color/secondary_text"
                        android:textSize="10sp"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:background="@drawable/vornex_status_pill"
                    android:text="●  READY"
                    android:textColor="@color/gold_soft"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="YOUR NEXT WORLD"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.13" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Ready to play?"
                android:textColor="@color/primary_text"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Your Minecraft adventure starts here."
                android:textColor="@color/secondary_text"
                android:textSize="13sp" />

            <com.kdt.mcgui.AccountSpinner
                android:id="@+id/account_spinner"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:dropDownWidth="@dimen/_250sdp"
                android:dropDownVerticalOffset="@dimen/_52sdp"
                android:paddingEnd="@dimen/_52sdp"
                android:background="@drawable/account_header_background" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/launcher_play_button"
                android:text="@string/main_play"
                android:textAllCaps="false"
                android:textColor="@color/launcher_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/vornex_card"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GAME VERSION"
                        android:textColor="@color/secondary_text"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />
                    <com.kdt.mcgui.mcVersionSpinner
                        android:id="@+id/mc_version_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:drawableEnd="@drawable/spinner_arrow"
                        app:drawableEndSize="@dimen/padding_heavy"
                        app:drawableStartIntegerScaling="true"
                        app:drawableStartSize="30dp"
                        app:drawableEndPadding="1dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/launcher_nav_item"
                    android:contentDescription="Edit selected version"
                    android:src="@drawable/ic_px_edit"
                    android:padding="11dp" />

                <ImageButton
                    android:id="@+id/add_version_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/launcher_nav_item"
                    android:contentDescription="Add Minecraft version"
                    android:src="@drawable/ic_add"
                    android:padding="11dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="EXPLORE &amp; CUSTOMIZE"
                    android:textColor="@color/primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VORNEX HUB"
                    android:textColor="@color/gold_soft"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/nav_mods_card"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/vornex_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="13dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_vornex_mods" android:contentDescription="Mods"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Mods" android:textColor="@color/primary_text" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New gameplay" android:textColor="@color/secondary_text" android:textSize="10sp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_resourcepacks"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/vornex_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="13dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_vornex_resourcepacks" android:contentDescription="Resource packs"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Resource Packs" android:textColor="@color/primary_text" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Change your look" android:textColor="@color/secondary_text" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/nav_shaders"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/vornex_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="13dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_vornex_shaders" android:contentDescription="Shaders"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Shaders" android:textColor="@color/primary_text" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Visual upgrades" android:textColor="@color/secondary_text" android:textSize="10sp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_modpacks"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/vornex_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="13dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_vornex_modpacks" android:contentDescription="Modpacks"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Modpacks" android:textColor="@color/primary_text" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ready-made setups" android:textColor="@color/secondary_text" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_skins_capes"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/vornex_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="15dp">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_px_edit" android:contentDescription="Skins and capes"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="13dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Skins &amp; Capes" android:textColor="@color/primary_text" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Make your character yours" android:textColor="@color/secondary_text" android:textSize="11sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/launcher_blue" android:textSize="28sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/home_dynamic_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/vornex_bottom_nav" />

    <LinearLayout
        android:id="@+id/vornex_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/vornex_nav_bar"
        android:paddingHorizontal="6dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView android:id="@+id/nav_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:drawableTop="@drawable/ic_vornex_home" android:drawablePadding="4dp" android:text="Home" android:textColor="@color/launcher_text" android:textSize="10sp" android:background="@drawable/launcher_nav_item" android:clickable="true" android:focusable="true" android:paddingTop="7dp" android:paddingBottom="4dp"/>
        <TextView android:id="@+id/nav_mods" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:drawableTop="@drawable/ic_vornex_folder" android:drawablePadding="4dp" android:text="Folder" android:textColor="@color/launcher_text" android:textSize="10sp" android:background="@drawable/launcher_nav_item" android:clickable="true" android:focusable="true" android:paddingTop="7dp" android:paddingBottom="4dp"/>
        <TextView android:id="@+id/nav_controls" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:drawableTop="@drawable/ic_vornex_controls" android:drawablePadding="4dp" android:text="Controls" android:textColor="@color/launcher_text" android:textSize="10sp" android:background="@drawable/launcher_nav_item" android:clickable="true" android:focusable="true" android:paddingTop="7dp" android:paddingBottom="4dp"/>
        <TextView android:id="@+id/nav_more" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:drawableTop="@drawable/ic_vornex_more" android:drawablePadding="4dp" android:text="More" android:textColor="@color/launcher_text" android:textSize="10sp" android:background="@drawable/launcher_nav_item" android:clickable="true" android:focusable="true" android:paddingTop="7dp" android:paddingBottom="4dp"/>
        <TextView android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:drawableTop="@drawable/ic_vornex_settings" android:drawablePadding="4dp" android:text="Settings" android:textColor="@color/launcher_text" android:textSize="10sp" android:background="@drawable/launcher_nav_item" android:clickable="true" android:focusable="true" android:paddingTop="7dp" android:paddingBottom="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>