<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background"
    android:paddingHorizontal="20dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/auth_choice_panel"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/auth_choice_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VORNEX ACCOUNT"
            android:textColor="@color/launcher_green_bright"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/auth_choice_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Choose how to sign in"
            android:textColor="@color/launcher_text"
            android:textSize="21sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/auth_choice_eyebrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/auth_choice_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:text="Select the account type you want to use"
            android:textColor="@color/launcher_muted"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/auth_choice_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_microsoft_authentication"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/auth_choice_microsoft"
            android:drawableStart="@drawable/ic_auth_ms"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:text="@string/auth_select_microsoft"
            android:textColor="@color/launcher_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            app:layout_constraintTop_toBottomOf="@id/auth_choice_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_elyby_authentication"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/auth_choice_elyby"
            android:drawableStart="@drawable/ic_auth_elyby"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:text="@string/auth_select_elyby"
            android:textColor="@color/launcher_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            app:layout_constraintTop_toBottomOf="@id/button_microsoft_authentication"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_local_authentication"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/auth_choice_offline"
            android:drawableStart="@drawable/ic_auth_offline"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:text="@string/auth_select_local"
            android:textColor="@color/launcher_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            app:layout_constraintTop_toBottomOf="@id/button_elyby_authentication"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="YOUR ACCOUNT  •  YOUR ADVENTURE"
            android:textColor="@color/launcher_muted"
            android:textSize="9sp"
            android:letterSpacing="0.08"
            app:layout_constraintTop_toBottomOf="@id/button_local_authentication"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
