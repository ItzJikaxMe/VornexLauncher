<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/auth_choice_panel"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHOOSE MINECRAFT VERSION"
        android:textColor="@color/launcher_green_bright"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:paddingBottom="5dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select a release, snapshot, or installed version"
        android:textColor="@color/launcher_muted"
        android:textSize="12sp"
        android:paddingBottom="12dp" />

    <ExpandableListView
        android:id="@+id/expendable_list_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_240sdp"
        android:groupIndicator="@null"
        android:divider="@color/launcher_panel_border"
        android:dividerHeight="1dp"
        android:childDivider="@color/launcher_panel_border"
        android:background="@android:color/transparent"
        android:scrollbarThumbVertical="@color/launcher_green_bright" />
</LinearLayout>